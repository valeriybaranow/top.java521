-- Insert sample schedule data
INSERT INTO [dbo].[Schedules] ([Class], [DayOfWeek], [Week], [LectureId], [LectureRoomId])
SELECT
    -- Random class between 1-8
    ABS(CHECKSUM(NEWID())) % 8 + 1 AS Class,
    -- Random day of week between 1-7
    ABS(CHECKSUM(NEWID())) % 7 + 1 AS DayOfWeek,
    -- Random week between 1-52
    ABS(CHECKSUM(NEWID())) % 52 + 1 AS Week,
    l.Id AS LectureId,
    -- Random lecture room (from existing rooms)
    (SELECT TOP 1 Id FROM [dbo].[LectureRooms] ORDER BY NEWID()) AS LectureRoomId
FROM [dbo].[Lectures] l
-- Create 2-3 schedule entries per lecture
CROSS JOIN (SELECT 1 AS n UNION SELECT 2 UNION SELECT 3) AS numbers
WHERE numbers.n <= (ABS(CHECKSUM(NEWID())) % 2 + 2) -- 2-3 entries per lecture
GO