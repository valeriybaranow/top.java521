-- Insert data into Curators table (using next 30 teachers as curators)
-- Note: We already have a Curators table with Name/Surname, so we'll modify it first
-- First, let's clear the existing data if any
DELETE FROM [dbo].[Curators]
GO

-- Now insert new data linking to Teachers
INSERT INTO [dbo].[Curators] ([TeacherId])
SELECT Id
FROM Teachers
WHERE Id BETWEEN 21 AND 50
GO

-- Insert data into Deans table (using senior teachers as deans)
INSERT INTO [dbo].[Deans] ([TeacherId])
SELECT Id
FROM Teachers
WHERE Id IN (
    SELECT TOP 10 Id
    FROM Teachers
    ORDER BY Salary DESC
)
GO

