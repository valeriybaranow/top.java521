-- Update Faculties with building numbers (1-5)
UPDATE [dbo].[Faculties] SET [Building] =
CASE
    WHEN [Id] = 1 THEN 1 -- Факультет компьютерных наук
    WHEN [Id] = 2 THEN 1 -- Инженерный факультет
    WHEN [Id] = 3 THEN 2 -- Экономический факультет
    WHEN [Id] = 4 THEN 2 -- Факультет иностранных языков
    WHEN [Id] = 5 THEN 3 -- Юридический факультет
    WHEN [Id] = 6 THEN 3 -- Медицинский факультет
    WHEN [Id] = 7 THEN 4 -- Факультет искусств
    WHEN [Id] = 8 THEN 4 -- Факультет естественных наук
    WHEN [Id] = 9 THEN 5 -- Филологический факультет
    WHEN [Id] = 10 THEN 5 -- Факультет психологии
END
GO

-- Update Departments with building numbers (same as their faculty)
UPDATE d
SET d.[Building] = f.[Building]
FROM [dbo].[Departments] d
JOIN [dbo].[Faculties] f ON d.[FacultyId] = f.[Id]
GO

-- For some departments, set different buildings than their faculty (example for 5 departments)
UPDATE [dbo].[Departments] SET [Building] =
CASE
    WHEN [Id] = 2 THEN 2 -- Кафедра искусственного интеллекта (перемещаем в корпус 2)
    WHEN [Id] = 5 THEN 3 -- Кафедра электротехники (перемещаем в корпус 3)
    WHEN [Id] = 8 THEN 4 -- Кафедра бухгалтерского учета (перемещаем в корпус 4)
    WHEN [Id] = 15 THEN 5 -- Кафедра гражданского права (перемещаем в корпус 5)
    WHEN [Id] = 22 THEN 1 -- Кафедра музыки (перемещаем в корпус 1)
END
WHERE [Id] IN (2, 5, 8, 15, 22)
GO


